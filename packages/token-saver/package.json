{
  "name": "@lumine/dsh-token-saver",
  "version": "0.1.0",
  "description": "Durable Lumine token-saving dial, prompt doctrine, and cheaper host subagent routing for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "lumine",
    "token-saver"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "prepare": "tsdown --config tsdown.prepare.config.mjs --config-loader native && tsdown --config tsdown.client.config.mjs --config-loader native && (node scripts/ensure-dsh-peers.mjs || true)",
    "build": "tsdown --config tsdown.config.mjs --config-loader native && tsdown --config tsdown.client.config.mjs --config-loader native",
    "build:prepare": "tsdown --config tsdown.prepare.config.mjs --config-loader native && tsdown --config tsdown.client.config.mjs --config-loader native",
    "test": "vitest run"
  },
  "dependencies": {
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
