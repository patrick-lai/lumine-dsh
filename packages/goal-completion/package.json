{
  "name": "@lumine/dsh-goal-completion",
  "version": "0.1.0",
  "description": "Fail-closed independent judge for DSH goal completion, plus ACP-only marker harvest for Lumine ACP sessions.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "lumine",
    "goal"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "tsdown --config tsdown.prepare.config.mjs --config-loader native && (node scripts/ensure-dsh-peers.mjs || true)",
    "build": "tsdown --config tsdown.config.mjs --config-loader native",
    "build:prepare": "tsdown --config tsdown.prepare.config.mjs --config-loader native",
    "test": "vitest run"
  },
  "dependencies": {
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-goal": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-goal": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
